{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "yachtdaywork.com" }],
      "destination": "https://www.yachtdaywork.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/e/:id",
      "destination": "/api/og?type=event&event=:id"
    },
    {
      "source": "/api/event-og",
      "destination": "/api/og?type=event"
    },
    {
      "source": "/api/job-og",
      "destination": "/api/og?type=job"
    },
    {
      "source": "/api/service-og",
      "destination": "/api/og?type=service"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
